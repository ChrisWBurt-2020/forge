{
  "name": "@cloudflare/forge-transformer-mcp",
  "version": "0.1.0",
  "description": "Generate a Model Context Protocol (MCP) server from a complete bundled OpenAPI specification",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudflare/forge"
  },
  "bin": {
    "forge-transformer-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "!**/*.map"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsx scripts/build-package.ts",
    "cli": "node dist/cli.js",
    "generate:from-openapi": "node dist/cli.js",
    "test": "node --import tsx --test src/transformer.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/forge": "workspace:*",
    "@types/node": "26.0.1",
    "esbuild": "0.27.3",
    "openapi-types": "12.1.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
